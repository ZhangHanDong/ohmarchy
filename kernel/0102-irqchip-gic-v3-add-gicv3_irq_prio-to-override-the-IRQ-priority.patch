From ea3f673a7bde0996b5a849cc7968b61ba2bf39e4 Mon Sep 17 00:00:00 2001
From: ohmarchy <ohmarchy@localhost>
Date: Fri, 23 Oct 2026 18:36:51 +0800
Subject: [PATCH] irqchip/gic-v3: add gicv3_irq_prio= to override the IRQ
 priority

v6.13 moved ordinary interrupts from GICD_INT_DEF_PRI (0xa0) to
GICV3_PRIO_IRQ (0xc0, or 0x80 in the non-secure view). Under the HarmonyOS
PC hypervisor (the Oseasy VM) no SPI reaches the guest afterwards: a
virtio-blk request completes in the used ring but its interrupt never
arrives, so the first partition-table read waits forever. v6.1, which
writes 0xa0, works on the same machine.

gicv3_irq_prio=<n> sets the priority used for ordinary interrupts, and
the boot message now reports the number of priority bits and the value
in use. The option is ignored when pseudo-NMIs are enabled.
---
 drivers/irqchip/irq-gic-v3.c | 27 +++++++++++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/drivers/irqchip/irq-gic-v3.c b/drivers/irqchip/irq-gic-v3.c
index 99444a1..e1bc9b7 100644
--- a/drivers/irqchip/irq-gic-v3.c
+++ b/drivers/irqchip/irq-gic-v3.c
@@ -162,6 +162,26 @@ static inline bool gic_dist_security_disabled(void)
 	return readl_relaxed(gic_data.dist_base + GICD_CTLR) & GICD_CTLR_DS;
 }
 
+/*
+ * gicv3_irq_prio=<n> sets the priority of ordinary interrupts, which v6.13
+ * moved from GICD_INT_DEF_PRI (0xa0) to GICV3_PRIO_IRQ. A hypervisor that
+ * implements few priority bits can round that onto the default PMR, leaving
+ * every SPI masked; the HarmonyOS PC hypervisor behind the Oseasy VM does.
+ * Ignored when pseudo-NMIs are in use, since they need the default layout.
+ */
+static int gicv3_irq_prio_override __initdata = -1;
+
+static int __init gicv3_irq_prio_setup(char *str)
+{
+	unsigned int prio;
+
+	if (kstrtouint(str, 0, &prio) || prio > 0xff)
+		return -EINVAL;
+	gicv3_irq_prio_override = prio;
+	return 0;
+}
+early_param("gicv3_irq_prio", gicv3_irq_prio_setup);
+
 static bool cpus_have_security_disabled __ro_after_init;
 static bool cpus_have_group0 __ro_after_init;
 
@@ -226,9 +246,12 @@ static void __init gic_prio_init(void)
 		dist_prio_nmi = __gicv3_prio_to_ns(dist_prio_nmi);
 	}
 
-	pr_info("GICD_CTLR.DS=%d, SCR_EL3.FIQ=%d\n",
+	if (gicv3_irq_prio_override >= 0 && !gic_prio_masking_enabled())
+		dist_prio_irq = gicv3_irq_prio_override;
+
+	pr_info("GICD_CTLR.DS=%d, SCR_EL3.FIQ=%d, %u priority bits, IRQ priority %#x\n",
 		cpus_have_security_disabled,
-		!cpus_have_group0);
+		!cpus_have_group0, gic_get_pribits(), dist_prio_irq);
 }
 
 static struct gic_kvm_info gic_v3_kvm_info __initdata;
